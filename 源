const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const { spawn } = require('child_process');
const fs = require('fs');
const path = require('fs');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: "*", methods: ["GET", "POST"] },
  transports: ['websocket', 'polling']
});
const port = process.env.PORT || 3000;

// 自动寻找系统可用的 Shell
const getShell = () => {
  if (fs.existsSync('/bin/bash')) return '/bin/bash';
  if (fs.existsSync('/usr/bin/bash')) return '/usr/bin/bash';
  return 'sh';
};

// ==================== 脚本保活守护进程逻辑 ====================
let guardianProcess = null;

function startGuardian() {
  const shellCmd = getShell();
  console.log('[Guardian] 正在当前工作目录下启动保活脚本...');

  // 1. 注入关键环境变量
  // 特别注意：我们显式指定 IP 为 127.0.0.1,防止 xray 尝试绑定 0.0.0.0 被 Render 拦截
  const envVars = {
    ...process.env,
    vwpt: "2086",
    uuid: "80axxxxxx822a-84caee677810",
    cdnym: "galaxy-argo.nzqk.clxxx.be",
    argo: "vwpt",
    agn: "galaxy-argo.nzqk.cxxxs.be",
    agk: "eyJhIjoiZjY3ZDMwNGRlODQ1YWE2YzliY2VkMTcwZjA1NjxxxxxxxxxxxmLTllYTgtNjY5MWM2YTliNDY4IiwicyI6Ik5UZzFORFUwWlRVdFl6aGtZUzAwT1RVeUxXSXlaR1V0T1Rjd1pHTTNZbUkyTkRkbSJ9",
    cfip: "galaxy-argo.nzqk.cloudns.be",
    IP: "127.0.0.1" // 强制 xray 绑定本地回环,绕过 Render 端口限制
  };

  // 2. 在当前工作目录下执行（当前目录在 Render 中拥有完整的 CPU 执行权限）
  const command = 'vwpt="2086" uuid="80axxxxxx822a-84caee677810" cdnym="galaxy-argo.nzqk.clxxx.be" argo="vwpt" agn="galaxy-argo.nzqk.cxxxs.be" agk="eyJhIjoiZjY3ZDMwNGRlODQ1YWE2YzliY2VkMTcwZjA1NjxxxxxxxxxxxmLTllYTgtNjY5MWM2YTliNDY4IiwicyI6Ik5UZzFORFUwWlRVdFl6aGtZUzAwT1RVeUxXSXlaR1V0T1Rjd1pHTTNZbUkyTkRkbSJ9" cfip="galaxy-argo.nzqk.cloudns.be" IP="127.0.0.1" bash <(curl -Ls https://raw.githubusercontent.com/yonggekkk/argosbx/main/argosbx.sh)';

  guardianProcess = spawn(shellCmd, ['-c', command], {
    cwd: process.cwd(), // 切换回当前工作目录,解决 /tmp 的 noexec 限制
    env: envVars
  });

  guardianProcess.stdout.on('data', (data) => {
    const out = data.toString().trim();
    if (out) console.log('[Guardian Output]: ' + out);
  });

  guardianProcess.stderr.on('data', (data) => {
    const err = data.toString().trim();
    if (err) console.error('[Guardian Error]: ' + err);
  });

  guardianProcess.on('close', (code) => {
    console.log('[Guardian] 脚本进程已退出,退出码: ' + code + '.将在 10 秒后重新启动...');
    guardianProcess = null;
    setTimeout(startGuardian, 10000);
  });
}

// 延迟 15 秒启动,给 Node.js 留出足够的空间先完成端口绑定和健康检查
setTimeout(startGuardian, 15000);
