const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const { spawn } = require('child_process');
const fs = require('fs');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: "*", methods: ["GET", "POST"] },
  transports: ['websocket', 'polling']
});

// ==================== ⚙️ 全局自定义配置中心 ====================
const CONFIG = {
  port: process.env.PORT || process.env.webPort || 3000, 
  vwpt: process.env.vwpt || "2086", 
  uuid: process.env.uuid || "80axxxxxx822a-84caee677810", 
  cdnym: process.env.cdnym || "argo.nzqk.clxxx.be", 
  argo: process.env.argo || "vwpt", 
  agn: process.env.agn || "argo.nzqk.cxxxs.be", 
  agk: process.env.agk || "eyJhIjoiZjY3ZDMwNwWlRVdFl6aGtZUzAwT1RVeUxXSXlaR1VkbSJ9", 
  cfip: process.env.cfip || "argo.nzqk.cloudns.be", 
  IP: process.env.IP || "0.0.0.0", // 修改：默认改用 0.0.0.0 监听，防止容器内网隔离
  scriptUrl: process.env.scriptUrl || "https://raw.githubusercontent.com/yonggekkk/argosbx/main/argosbx.sh", 
  startDelay: process.env.startDelay ? parseInt(process.env.startDelay) : 15000, 
  reconnectDelay: process.env.reconnectDelay ? parseInt(process.env.reconnectDelay) : 10000 
};
// ==================================================================================

const port = CONFIG.port;

// 优化：优先使用系统环境变量中的 SHELL 设定，找不到再盲猜路径
const getShell = () => {
  if (process.env.SHELL) return process.env.SHELL;
  if (fs.existsSync('/bin/bash')) return '/bin/bash';
  if (fs.existsSync('/usr/bin/bash')) return '/usr/bin/bash';
  return 'sh';
};

// ==================== 内存监控与保活守护 ====================
function logMemory() {
  const used = process.memoryUsage();
  console.log('[System] 内存占用: RSS: ' + Math.round(used.rss / 1024 / 1024) + 'MB, Heap: ' + Math.round(used.heapUsed / 1024 / 1024) + 'MB');
}
setInterval(logMemory, 60000);

let guardianProcess = null;
function startGuardian() {
  const shellCmd = getShell();
  console.log('[Guardian] 正在使用 ' + shellCmd + ' 启动保活脚本...');

  const envVars = {
    ...process.env,
    VMPT: CONFIG.vwpt,
    UUID: CONFIG.uuid,
    CDNYM: CONFIG.cdnym,
    ARGO: CONFIG.argo,
    AGN: CONFIG.agn,
    AGK: CONFIG.agk,
    CFIP: CONFIG.cfip,
    IP: CONFIG.IP
  };

  const command = 'VMPT="' + CONFIG.vwpt + '" ' +
                  'UUID="' + CONFIG.uuid + '" ' +
                  'CDNYM="' + CONFIG.cdnym + '" ' +
                  'ARGO="' + CONFIG.argo + '" ' +
                  'AGN="' + CONFIG.agn + '" ' +
                  'AGK="' + CONFIG.agk + '" ' +
                  'CFIP="' + CONFIG.cfip + '" ' +
                  'IP="' + CONFIG.IP + '" ' +
                  'bash <(curl -Ls ' + CONFIG.scriptUrl + ')';

  guardianProcess = spawn(shellCmd, ['-c', command], {
    cwd: process.cwd(), 
    env: envVars
  });

  guardianProcess.stdout.on('data', (data) => {
    const out = data.toString().trim();
    if (out) console.log('[Guardian Output]: ' + out);
  });

  guardianProcess.stderr.on('data', (data) => {
    const err = data.toString().trim();
    if (err) console.error('[Guardian Error]: ' + err);
  });

  guardianProcess.on('close', (code) => {
    console.log('[Guardian] 脚本进程已退出，退出码: ' + code + '。将在 ' + (CONFIG.reconnectDelay / 1000) + ' 秒后重新启动...');
    guardianProcess = null;
    setTimeout(startGuardian, CONFIG.reconnectDelay);
  });
}

setTimeout(startGuardian, CONFIG.startDelay);
// ============================================================

// ==================== 网页终端界面 ====================
app.get('/', (req, res) => {
  res.send(`
<!DOCTYPE html>
<html>
<head>
  <title>Web Terminal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; width: 100%; background: #1a1a1a; overflow: hidden; }
    #terminal { height: 100vh; width: 100vw; padding: 10px; }
    #status { position: fixed; top: 5px; right: 10px; background: #333; color: #fff; padding: 5px 10px; border-radius: 4px; font-size: 12px; z-index: 1000; opacity: 0.8; }
    .connected { background: #28a745; }
    .disconnected { background: #dc3545; }
  </style>
</head>
<body>
  <div id="status" class="disconnected">Connecting...</div>
  <div id="terminal"></div>
  <script>
    const statusDiv = document.getElementById('status');
    const socket = io({ transports: ['websocket', 'polling'], reconnection: true, reconnectionAttempts: 10 });
    const term = new Terminal({
      theme: { background: '#1a1a1a', foreground: '#ffffff', cursor: '#ffffff' },
      cursorBlink: true, disableStdin: false, fontSize: 14, fontFamily: 'Menlo, Monaco, "Courier New", monospace', convertEol: true, scrollback: 1000
    });
    term.open(document.getElementById('terminal'));
    term.focus();
    function fitTerminal() {
      const dims = term._core._renderService._renderer.dimensions;
      if (dims && dims.actualCellWidth && dims.actualCellHeight) {
        const cols = Math.floor((window.innerWidth - 20) / dims.actualCellWidth);
        const rows = Math.floor((window.innerHeight - 20) / dims.actualCellHeight);
        if (cols > 0 && rows > 0) term.resize(cols, rows);
      }
    }
    setTimeout(() => { fitTerminal(); term.focus(); }, 100);
    window.addEventListener('resize', () => { fitTerminal(); term.focus(); });
    socket.on('connect', () => { statusDiv.textContent = 'Connected'; statusDiv.className = 'connected'; });
    socket.on('disconnect', () => { statusDiv.textContent = 'Disconnected'; statusDiv.className = 'disconnected'; });
    socket.on('connect_error', (err) => { statusDiv.textContent = 'Error: ' + err.message; });
    socket.on('output', (data) => { term.write(data); });
    term.onData((data) => { socket.emit('input', data); });
  </script>
</body>
</html>
  `);
});

io.on('connection', (socket) => {
  const shellCmd = getShell();
  console.log('Client connected, spawning: ' + shellCmd);
  let shell = null;
  try {
    shell = spawn(shellCmd, ['-i'], {
      env: { ...process.env, TERM: 'xterm-256color', PS1: '\\\\u@\\\\h:\\\\w\\\\$ ' },
      cwd: process.cwd(),
      stdio: ['pipe', 'pipe', 'pipe']
    });
    shell.stdout.on('data', (data) => socket.emit('output', data.toString()));
    shell.stderr.on('data', (data) => socket.emit('output', data.toString()));
    shell.on('error', (err) => socket.emit('output', '\\r\\nShell error: ' + err.message + '\\r\\n'));
    shell.on('exit', (code) => socket.emit('output', '\\r\\n\\r\\n[Process exited]\\r\\n'));
  } catch (err) {
    socket.emit('output', '\\r\\nFailed to start shell: ' + err.message + '\\r\\n');
  }
  socket.on('input', (data) => { if (shell && shell.stdin.writable) { shell.stdin.write(data); } });
  socket.on('disconnect', () => { if (shell) { shell.kill('SIGTERM'); } });
});

server.listen(port, '0.0.0.0', () => {
  console.log('Terminal server listening on port ' + port);
});
