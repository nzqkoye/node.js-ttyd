const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const { spawn } = require('child_process');
const fs = require('fs');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: "*", methods: ["GET", "POST"] },
  transports: ['websocket', 'polling']
});
const port = process.env.PORT || 3000;

// 自动寻找系统可用的 Shell
const getShell = () => {
  if (fs.existsSync('/bin/bash')) return '/bin/bash';
  if (fs.existsSync('/usr/bin/bash')) return '/usr/bin/bash';
  return 'sh';
};

// ==================== 脚本保活守护进程逻辑 ====================
let guardianProcess = null;
function startGuardian() {
  const shellCmd = getShell();
  console.log('[Guardian] 使用 ' + shellCmd + ' 启动脚本...');
  
  const command = 'cd /tmp && vwpt="2086" uuid="4c1c82ca-3b98-493c-a619-2xxxxxxxxx1" cdnym="render-argo.xxxx.cloudns.be" argo="vwpt" agn="render-argo.xxxx.cloudns.be" agk="eyJhIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx2IiwicyI6Ik9HVTNOakptWkRVdE5URmtNUzAwT0RkakxUaGxaak10TVRBME0yRmxNRFk0WkdKbSJ9" cfip="render-argo.xxxx.cloudns.be" bash <(curl -Ls https://raw.githubusercontent.com/yonggekkk/argosbx/main/argosbx.sh)';

  guardianProcess = spawn(shellCmd, ['-c', command], {
    cwd: '/tmp',
    env: process.env
  });

  guardianProcess.stdout.on('data', (data) => console.log('[Guardian]: ' + data.toString().trim()));
  guardianProcess.stderr.on('data', (data) => console.error('[Guardian Error]: ' + data.toString().trim()));
  
  guardianProcess.on('close', (code) => {
    console.log('[Guardian] 退出码 ' + code + '.10秒后重启...');
    setTimeout(startGuardian, 10000);
  });
}
setTimeout(startGuardian, 8000);

// ==================== Web 界面 ====================
app.get('/', (req, res) => {
  res.send(`
<!DOCTYPE html>
<html>
<head>
  <title>Web Terminal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; width: 100%; background: #1a1a1a; overflow: hidden; }
    #terminal { height: 100vh; width: 100vw; padding: 10px; }
    #status { position: fixed; top: 5px; right: 10px; background: #333; color: #fff; padding: 5px 10px; border-radius: 4px; font-size: 12px; z-index: 1000; opacity: 0.8; }
    .connected { background: #28a745; }
    .disconnected { background: #dc3545; }
  </style>
</head>
<body>
  <div id="status" class="disconnected">Connecting...</div>
  <div id="terminal"></div>
  <script>
    const statusDiv = document.getElementById('status');
    const socket = io({ transports: ['websocket', 'polling'], reconnection: true });
    const term = new Terminal({ theme: { background: '#1a1a1a' }, cursorBlink: true, convertEol: true });
    term.open(document.getElementById('terminal'));
    term.focus();
    window.addEventListener('resize', () => term.focus());
    socket.on('connect', () => { statusDiv.textContent = 'Connected'; statusDiv.className = 'connected'; });
    socket.on('disconnect', () => { statusDiv.textContent = 'Disconnected'; statusDiv.className = 'disconnected'; });
    socket.on('output', (data) => term.write(data));
    term.onData((data) => socket.emit('input', data));
  </script>
</body>
</html>
  `);
});

io.on('connection', (socket) => {
  const shellCmd = getShell();
  console.log('Client connected, spawning: ' + shellCmd);
  const shell = spawn(shellCmd, ['-i'], {
    env: { ...process.env, TERM: 'xterm-256color', PS1: '\\\\u@\\\\h:\\\\w\\\\$ ' },
    cwd: process.cwd(),
    stdio: ['pipe', 'pipe', 'pipe']
  });
  shell.stdout.on('data', (data) => socket.emit('output', data.toString()));
  shell.stderr.on('data', (data) => socket.emit('output', data.toString()));
  socket.on('input', (data) => { if (shell.stdin.writable) shell.stdin.write(data); });
  socket.on('disconnect', () => shell.kill());
});

server.listen(port, '0.0.0.0', () => console.log('Server on port ' + port));
